# Environnement
NODE_ENV=development
API_PORT=3001
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VITE_API_URL=http://localhost:3001/api

# Administration : en production, utilisez ADMIN_PASSWORD_HASH et supprimez ADMIN_PASSWORD.
ADMIN_USERNAME=Honore
ADMIN_PASSWORD=Honore@16.
# SESSION_SECRET doit contenir une valeur aléatoire longue, différente par environnement.
SESSION_SECRET=change-this-local-session-secret
# Générer le hash : node scripts/generate-admin-hash.mjs 'votre-mot-de-passe-long'
# ADMIN_PASSWORD_HASH=salt:hash_hex

# PostgreSQL. Sans DATABASE_URL, le prototype utilise data/*.json.
# DATABASE_URL=postgresql://echoppe_user:mot_de_passe@localhost:5432/echoppe_togo
# DATABASE_SSL=true
# DATABASE_POOL_MAX=10

# S3 ou Cloudflare R2. Sans ces variables, les fichiers restent dans data/uploads/.
# S3_BUCKET=echoppe-togo-private
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false
# S3_SERVER_SIDE_ENCRYPTION=AES256
